<view class="nav-wrap" style="padding-top:{{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="nav-btns">
      <view wx:if="{{showBack}}" class="nav-btn" bindtap="onBack" hover-class="nav-btn-hover">
        <image class="nav-btn-icon" src="{{icons.arrow_left[0]}}" mode="aspectFit"/>
      </view>
      <view wx:else class="nav-logo">
        <view class="nav-logo-core"></view>
      </view>
    </view>
    <view class="nav-title">{{title}}</view>
    <view class="nav-right">
      <slot name="right"></slot>
    </view>
  </view>
</view>
