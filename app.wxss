/* ========== 深色物流驾驶舱 · 设计系统 ========== */
page {
  background: #0a0f1e;
  background-image:
    radial-gradient(1100rpx 1100rpx at 115% -8%, rgba(59, 130, 246, 0.14), transparent 60%),
    radial-gradient(900rpx 900rpx at -15% 108%, rgba(34, 211, 238, 0.09), transparent 62%),
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='80' height='80'><path d='M80 0H0v80' fill='none' stroke='rgba(130,165,215,0.07)' stroke-width='1'/></svg>");
  color: #e6edf7;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx;
  line-height: 1.55;
  min-height: 100vh;
}

/* ---------- 容器 ---------- */
.page {
  padding: 28rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 卡片 ---------- */
.card {
  background: linear-gradient(160deg, rgba(24, 34, 58, 0.97), rgba(15, 22, 40, 0.99));
  border: 1px solid rgba(133, 168, 226, 0.30);
  border-radius: 28rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(2, 6, 16, 0.40), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}
.card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.55), transparent);
  opacity: 0.55;
}
.card.plain::before { display: none; }
.card.clickable { transition: transform 130ms ease, border-color 160ms ease; }
.card.clickable:active { transform: scale(0.985); border-color: rgba(133, 168, 226, 0.52); }

.row { display: flex; align-items: center; }
.row.between { justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }
.gap8 { gap: 8rpx; } .gap12 { gap: 12rpx; } .gap16 { gap: 16rpx; } .gap24 { gap: 24rpx; }
.mt16 { margin-top: 16rpx; } .mt24 { margin-top: 24rpx; } .mb8 { margin-bottom: 8rpx; }

/* ---------- 文字 ---------- */
.title-lg { font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; }
.title-md { font-size: 32rpx; font-weight: 600; }
.title-sm { font-size: 28rpx; font-weight: 500; }
.text-main { color: #e6edf7; }
.text-sub { color: #a8bad6; }
.text-dim { color: #8ea3c2; }
.text-xs { font-size: 23rpx; }
.text-sm { font-size: 24rpx; }
.ellip { display: block; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.clamp2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.clamp3 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.num { font-family: 'DIN Alternate', 'Bahnschrift', 'Arial', sans-serif; font-weight: 700; font-feature-settings: "tnum"; font-variant-numeric: tabular-nums; }

/* ---------- 状态标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  border: 1px solid;
  background: rgba(255, 255, 255, 0.03);
  line-height: 1.4;
}
.tag > text.dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  margin-right: 10rpx;
}
.pill {
  display: inline-flex; align-items: center;
  padding: 10rpx 24rpx; border-radius: 999rpx;
  font-size: 24rpx; font-weight: 600;
}
.pill.fill { color: #0a0f1e; }

/* 状态色 */
.c-warn  { color: #f59e0b; } .bg-warn  { background: rgba(245, 158, 11, 0.14); } .brd-warn  { border-color: rgba(245, 158, 11, 0.45); }
.c-blue  { color: #4d8dff; } .bg-blue  { background: rgba(77, 141, 255, 0.14); } .brd-blue  { border-color: rgba(77, 141, 255, 0.45); }
.c-cyan  { color: #22d3ee; } .bg-cyan  { background: rgba(34, 211, 238, 0.14); } .brd-cyan  { border-color: rgba(34, 211, 238, 0.45); }
.c-purple{ color: #a78bfa; } .bg-purple{ background: rgba(167, 139, 250, 0.14); } .brd-purple{ border-color: rgba(167, 139, 250, 0.45); }
.c-green { color: #34d399; } .bg-green { background: rgba(52, 211, 153, 0.14); } .brd-green { border-color: rgba(52, 211, 153, 0.45); }
.c-red   { color: #f87171; } .bg-red   { background: rgba(248, 113, 113, 0.14); } .brd-red   { border-color: rgba(248, 113, 113, 0.45); }

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 0 36rpx; height: 84rpx;
  border-radius: 22rpx;
  font-size: 28rpx; font-weight: 600;
  box-sizing: border-box;
}
.btn::after { border: none; }
.btn:active { opacity: 0.9; }
.button-hover { opacity: 0.9; }
.btn.block { display: flex; width: 100%; }
.btn.primary {
  background: linear-gradient(135deg, #2f6bff, #22d3ee);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(47, 107, 255, 0.32);
}
.btn.primary:active { opacity: 0.88; }
.btn.ghost {
  background: rgba(77, 141, 255, 0.1);
  border: 1px solid rgba(77, 141, 255, 0.4);
  color: #8fb2ff;
}
.btn.soft {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: #dae4f5;
}
.btn.danger {
  background: rgba(248, 113, 113, 0.1);
  border: 1px solid rgba(248, 113, 113, 0.4);
  color: #fca5a5;
}
.btn.dark { background: transparent; border: none; color: #a8bad6; }
.btn.sm { height: 64rpx; padding: 0 26rpx; font-size: 25rpx; border-radius: 18rpx; }

/* ---------- 图标按钮 ---------- */
.icon-btn {
  width: 76rpx; height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
}
.icon-btn:active { background: rgba(255, 255, 255, 0.17); }
.icon { width: 40rpx; height: 40rpx; }
.icon-sm { width: 32rpx; height: 32rpx; }
.icon-lg { width: 64rpx; height: 64rpx; }

/* ---------- 通用图标底板（v9 全局化，各页复用） ---------- */
.d-icon {
  width: 68rpx; height: 68rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.di-warn  { background: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.4); }
.di-cyan  { background: rgba(34, 211, 238, 0.14); border: 1px solid rgba(34, 211, 238, 0.4); }
.di-green { background: rgba(52, 211, 153, 0.14); border: 1px solid rgba(52, 211, 153, 0.4); }
.di-blue  { background: rgba(77, 141, 255, 0.14); border: 1px solid rgba(77, 141, 255, 0.4); }

/* ---------- 分隔线 ---------- */
.divider { height: 1px; background: rgba(255, 255, 255, 0.14); margin: 24rpx 0; }

/* ---------- 仪表 / 进度 ---------- */
.meter {
  height: 14rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  overflow: hidden; position: relative;
}
.meter > view {
  height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #2f6bff, #22d3ee);
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.6);
  transition: width 420ms cubic-bezier(0.22, 0.9, 0.28, 1);
}

/* 扫描线动画 */
@keyframes scan {
  0% { transform: translateY(-30rpx); opacity: 0; }
  15% { opacity: 1; }
  100% { transform: translateY(60rpx); opacity: 0; }
}
.scanline {
  position: absolute; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.9), transparent);
  animation: scan 2.2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.86); }
}
.pulse { animation: pulse 1.6s ease-in-out infinite; }

/* 弧形 ====== 顶部渐变条 */
.hero {
  padding: 36rpx 30rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
  background: linear-gradient(170deg, rgba(34, 70, 140, 0.75), rgba(10, 15, 30, 0.4) 45%, rgba(10, 15, 30, 0));
  border: 1px solid rgba(133, 168, 226, 0.28);
  border-top: none;
  position: relative;
  overflow: hidden;
  margin: 0 -28rpx 24rpx;
}
.hero .grid-deco {
  position: absolute; right: -40rpx; top: -40rpx;
  width: 300rpx; height: 300rpx;
  background:
    radial-gradient(circle, rgba(34, 211, 238, 0.22) 1px, transparent 1.6px) 0 0 / 34rpx 34rpx;
  border-radius: 50%;
  opacity: 0.4;
}

/* 空态 */
.empty {
  padding: 72rpx 32rpx;
  text-align: center;
  color: #93a7c4;
  font-size: 26rpx;
  line-height: 1.7;
  border: 1px dashed rgba(133, 168, 226, 0.24);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.02);
}
.empty::before {
  content: '';
  display: block;
  width: 64rpx; height: 64rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  border: 2px dashed rgba(133, 168, 226, 0.38);
}

/* 时间线 */
.timeline { padding-left: 4rpx; }
.tl-item { position: relative; padding-left: 44rpx; padding-bottom: 34rpx; }
.tl-item::before {
  content: ''; position: absolute; left: 10rpx; top: 30rpx; bottom: -4rpx;
  width: 1px; background: rgba(133, 168, 226, 0.36);
}
.tl-item:last-child::before { display: none; }
.tl-item .tl-dot {
  position: absolute; left: 0; top: 6rpx;
  width: 22rpx; height: 22rpx; border-radius: 50%;
  background: rgba(34, 211, 238, 0.22);
  border: 2px solid #22d3ee;
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.7);
}
.tl-item.done .tl-dot { background: #34d399; border-color: #34d399; box-shadow: 0 0 6rpx rgba(52, 211, 153, 0.7); }
.tl-item.ghost .tl-dot { background: rgba(255,255,255,0.06); border-color: #3a4966; box-shadow: none; }
.tl-item.ghost .tl-line { color: #8ea3c2; }

/* ---------- 间距工具 ---------- */
.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mb20 { margin-bottom: 20rpx; }

/* ---------- Hero 视觉层（全页面复用） ---------- */
.hero-kicker {
  display: inline-flex; align-items: center;
  font-size: 23rpx; font-weight: 700;
  letter-spacing: 4rpx;
  color: #4d8dff;
  margin-bottom: 14rpx;
}
.hero-kicker::before {
  content: '';
  width: 6rpx; height: 20rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #22d3ee, #2f6bff);
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.8);
}
.hero-title {
  font-size: 42rpx; font-weight: 800;
  color: #eaf2ff;
  letter-spacing: 1rpx;
}
.hero-sub {
  font-size: 24rpx; color: #a8bad6; margin-top: 10rpx;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.hero-emblem {
  width: 112rpx; height: 112rpx;
  border-radius: 30rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(145deg, rgba(47, 107, 255, 0.2), rgba(34, 211, 238, 0.12));
  border: 1px solid rgba(77, 141, 255, 0.42);
  box-shadow: 0 0 6rpx rgba(47, 107, 255, 0.28);
  position: relative;
}
.lg-emblem { background: linear-gradient(145deg, rgba(34, 211, 238, 0.2), rgba(52, 211, 153, 0.12)); border-color: rgba(34, 211, 238, 0.5); }
.lg-tip {
  position: absolute; bottom: -28rpx; left: 50%;
  transform: translateX(-50%);
  font-size: 23rpx; color: #a8bad6; white-space: nowrap;
  padding: 0 10rpx;
}
.hero-stats {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  justify-content: space-between;
}
.hero-stat {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  gap: 6rpx;
}
.stat-num { font-size: 42rpx; line-height: 1.1; }
.stat-k { font-size: 23rpx; }

/* 卡片按压态 */
.role-card-hover {
  background: rgba(77, 141, 255, 0.09) !important;
  border-color: rgba(77, 141, 255, 0.42) !important;
  transform: scale(0.985);
}

/* ==================== v7 公共扩展：双端登录 / 运输状态 / 调度操作 ==================== */

/* 间距补全 */
.gap12 { gap: 12rpx; }
.gap16 { gap: 16rpx; }
.gap20 { gap: 20rpx; }
.gap24 { gap: 24rpx; }
.mt4 { margin-top: 4rpx; }
.mt24 { margin-top: 24rpx; }
.mt28 { margin-top: 28rpx; }

/* 图标光晕块 */
.glow-g {
  background: linear-gradient(145deg, rgba(52, 211, 153, 0.22), rgba(34, 211, 238, 0.12));
  border: 1px solid rgba(52, 211, 153, 0.42);
  box-shadow: 0 0 6rpx rgba(52, 211, 153, 0.22);
}
.glow-b {
  background: linear-gradient(145deg, rgba(47, 107, 255, 0.22), rgba(34, 211, 238, 0.12));
  border: 1px solid rgba(77, 141, 255, 0.42);
  box-shadow: 0 0 6rpx rgba(47, 107, 255, 0.26);
}
.glow-c {
  background: linear-gradient(145deg, rgba(167, 139, 250, 0.22), rgba(47, 107, 255, 0.12));
  border: 1px solid rgba(167, 139, 250, 0.42);
  box-shadow: 0 0 6rpx rgba(167, 139, 250, 0.22);
}
.glow-d {
  background: linear-gradient(145deg, rgba(148, 163, 184, 0.18), rgba(15, 22, 40, 0.6));
  border: 1px solid rgba(148, 163, 184, 0.3);
}

/* 状态芯片 */
.chip {
  display: inline-flex; align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #a3b6d2;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.17);
}
.chip.on {
  color: #34d399;
  background: rgba(52, 211, 153, 0.12);
  border-color: rgba(52, 211, 153, 0.45);
}
.chip.warn {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.12);
  border-color: rgba(251, 191, 36, 0.42);
}

/* 未读角标 */
.badge {
  min-width: 36rpx; height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f43f5e, #fb7185);
  color: #fff; font-size: 23rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 6rpx rgba(244, 63, 94, 0.5);
}

/* 货物运输进度轴 */
.stage-axis {
  display: flex; align-items: flex-start;
  justify-content: space-between;
  margin: 22rpx 0 4rpx;
}
.stage-node {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  position: relative;
}
.stage-node .sd {
  width: 18rpx; height: 18rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.16);
  z-index: 2;
}
.stage-node .sl {
  position: absolute; top: 8rpx; left: 50%; right: -50%;
  height: 1px;
  background: rgba(255, 255, 255, 0.18);
}
.stage-node:last-child .sl { display: none; }
.stage-node.done .sd {
  background: #22d3ee; border-color: #22d3ee;
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.8);
}
.stage-node.done .sl { background: linear-gradient(90deg, #22d3ee, #2f6bff); }
.stage-node.active .sd {
  background: #2f6bff; border-color: #7dd3fc;
  box-shadow: 0 0 6rpx rgba(47, 107, 255, 0.9);
  animation: pulse 1.8s ease-in-out infinite;
}
.stage-node .st { font-size: 23rpx; color: #a3b6d2; margin-top: 12rpx; text-align: center; }
.stage-node.done .st { color: #c6d6ec; }
.stage-node.active .st { color: #7dd3fc; font-weight: 700; }

/* 关键信息网格 */
.kv-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.kv {
  width: calc(50% - 7rpx);
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.14);
}
.kv.full { width: 100%; }
.kv-k { font-size: 23rpx; color: #a3b6d2; letter-spacing: 1rpx; }
.kv-v { font-size: 25rpx; color: #e6edf7; font-weight: 600; margin-top: 8rpx; word-break: break-all; }

/* 底部固定操作栏 */
.fixed-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(10, 15, 30, 0), rgba(10, 15, 30, 0.94) 40%);
  box-sizing: border-box;
  z-index: 60;
}
.page.has-bar { padding-bottom: calc(230rpx + env(safe-area-inset-bottom)); }

/* 选择弹层 */
.picker-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(3, 7, 16, 0.66);
  z-index: 80;
}
.picker-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  max-height: 72vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: linear-gradient(180deg, #131c33, #0c1224);
  border-top: 1px solid rgba(77, 141, 255, 0.35);
  box-shadow: 0 -8rpx 18rpx rgba(0, 0, 0, 0.50);
  z-index: 90;
  overflow-y: auto;
  box-sizing: border-box;
}
.picker-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.14);
  margin-bottom: 14rpx;
}
.picker-item.on {
  background: rgba(77, 141, 255, 0.14);
  border-color: rgba(77, 141, 255, 0.5);
}
.picker-item:active { background: rgba(77, 141, 255, 0.1); }
.picker-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 22rpx;
}

/* 区块标题（与首页保持一致的深空样式） */
.section-title {
  font-size: 29rpx; font-weight: 700;
  margin: 0 6rpx 10rpx;
  display: flex; align-items: center;
  letter-spacing: 1rpx;
}
.section-title::before {
  content: '';
  width: 8rpx; height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6bff, #22d3ee);
  margin-right: 14rpx;
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.5);
}
.mb24 { margin-bottom: 24rpx; }


/* ===== v7 状态胶囊（运输状态标签） ===== */
.state-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* ---------- 卡片按压缩放（供 hover-class 使用） ---------- */
.card-hover { transform: scale(0.985); opacity: 0.97; }

/* ---------- 轻量点击反馈（小元素用） ---------- */
.tap-hover { opacity: 0.82; }

/* ===== v9 标题单行溢出保护 ===== */
.title-sm, .title-xs { max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* ===== v9 弹层进出场动效 ===== */
.picker-mask { animation: maskIn 180ms ease; }
.picker-panel { animation: panelIn 240ms cubic-bezier(0.22, 0.9, 0.28, 1); }
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes panelIn { from { transform: translateY(32rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
