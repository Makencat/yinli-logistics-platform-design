.hero-emblem {
  width: 128rpx; height: 128rpx;
  border-radius: 34rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 6rpx rgba(167, 139, 250, 0.22);
  margin-right: 10rpx;
}
.wh-emblem {
  background: rgba(167, 139, 250, 0.14);
  border: 1px solid rgba(167, 139, 250, 0.4);
}

.section-title {
  font-size: 30rpx; font-weight: 700;
  margin: 30rpx 6rpx 18rpx;
  display: flex; align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx; height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6bff, #22d3ee);
  margin-right: 14rpx;
}
.d-icon {
  width: 68rpx; height: 68rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.di-warn { background: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.4); }
.d-meta { flex-wrap: wrap; }
.d-k { font-size: 24rpx; color: #93a7c4; }
.d-v { color: #dbe6f7; font-weight: 500; }

/* 月台网格 */
.dock-grid {
  display: flex; flex-wrap: wrap;
  gap: 18rpx;
}
.dock-cell {
  width: calc(33.333% - 12rpx);
  box-sizing: border-box;
  border-radius: 22rpx;
  padding: 22rpx 8rpx 0;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.14);
  text-align: center;
  position: relative;
  height: 138rpx;
  display: flex; flex-direction: column; align-items: center;
}
.dock-used {
  background: linear-gradient(160deg, rgba(47, 107, 255, 0.16), rgba(34, 211, 238, 0.08));
  border-color: rgba(77, 141, 255, 0.4);
}
.dock-name { font-size: 26rpx; font-weight: 600; color: #dae4f5; }
.dock-status { font-size: 23rpx; margin-top: 8rpx; }
.dock-light {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  margin-top: 10rpx;
}
