.state-banner {
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  border: 1px solid;
}
.state-reserved {
  background: linear-gradient(135deg, rgba(47, 107, 255, 0.3), rgba(34, 211, 238, 0.18));
  border-color: rgba(77, 141, 255, 0.4);
}
.state-warn {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.22), rgba(248, 113, 113, 0.12));
  border-color: rgba(245, 158, 11, 0.45);
}
.state-done {
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.22), rgba(34, 211, 238, 0.14));
  border-color: rgba(52, 211, 153, 0.4);
}
.scanline {
  position: absolute; top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, #22d3ee, transparent);
  animation: scan 2.4s linear infinite;
}
@keyframes scan { 0% { transform: translateX(-100%);} 100% { transform: translateX(100%);} }
.sb-kicker { font-size: 23rpx; letter-spacing: 4rpx; opacity: 0.555; }
.sb-title { font-size: 42rpx; font-weight: 800; margin: 8rpx 0 4rpx; }
.sb-sub { font-size: 24rpx; opacity: 0.85; }
.sb-icon {
  width: 110rpx; height: 110rpx;
  border-radius: 30rpx;
  background: rgba(10, 15, 30, 0.4);
  display: flex; align-items: center; justify-content: center;
}
.card-head { margin-bottom: 6rpx; }
.plate-chip {
  background: linear-gradient(90deg, #0b1226, #12203f);
  border: 1px solid rgba(34, 211, 238, 0.55);
  border-radius: 12rpx;
  padding: 14rpx 22rpx;
  flex-shrink: 0;
}
.plate-text {
  font-family: 'Bahnschrift', 'Arial', sans-serif;
  font-weight: 700;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: #22d3ee;
}
.divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.15);
  margin: 22rpx 0;
}
.f-item { margin-bottom: 20rpx; }
.f-label { font-size: 24rpx; color: #a8bad6; margin-bottom: 12rpx; }
.f-picker-v {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 18rpx;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between;
  font-size: 28rpx;
}
.f-picker-v image { transform: rotate(90deg); opacity: 0.6; }
.section-title {
  font-size: 30rpx; font-weight: 700;
  margin: 30rpx 6rpx 18rpx;
  display: flex; align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx; height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6bff, #22d3ee);
  margin-right: 14rpx;
}
.tl-line { display: block; }
