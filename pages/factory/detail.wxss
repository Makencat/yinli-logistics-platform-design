.state-banner {
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  border: 1px solid;
}
.state-pending {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.24), rgba(248, 113, 113, 0.16));
  border-color: rgba(245, 158, 11, 0.4);
}
.state-reserved {
  background: linear-gradient(135deg, rgba(47, 107, 255, 0.3), rgba(34, 211, 238, 0.18));
  border-color: rgba(77, 141, 255, 0.4);
}
.state-done {
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.22), rgba(34, 211, 238, 0.14));
  border-color: rgba(52, 211, 153, 0.4);
}
.sb-kicker { font-size: 23rpx; letter-spacing: 4rpx; opacity: 0.555; }
.sb-title { font-size: 42rpx; font-weight: 800; margin: 8rpx 0 4rpx; }
.sb-sub { font-size: 24rpx; opacity: 0.85; }
.sb-icon {
  width: 110rpx; height: 110rpx;
  border-radius: 30rpx;
  background: rgba(10, 15, 30, 0.4);
  display: flex; align-items: center; justify-content: center;
}

.card-head { margin-bottom: 22rpx; }
.info-grid { display: flex; flex-wrap: wrap; row-gap: 24rpx; }
.info-item { width: 50%; display: flex; flex-direction: column; gap: 6rpx; }
.info-k { font-size: 23rpx; color: #93a7c4; }
.info-v { font-size: 28rpx; color: #dbe6f7; font-weight: 500; }

.ghost-wait {
  border-style: dashed;
  border-color: rgba(34, 211, 238, 0.4);
  background: rgba(34, 211, 238, 0.05);
}
