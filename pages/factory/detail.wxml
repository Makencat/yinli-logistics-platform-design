<nav-bar title="需求单详情" show-back="{{true}}"></nav-bar>

<view class="page" wx:if="{{demand}}">
  <!-- 状态横幅 -->
  <view class="state-banner state-{{demand.status}}">
    <view class="scanline" wx:if="{{demand.status === 'reserved'}}"></view>
    <view class="row between">
      <view class="col">
        <view class="sb-kicker">{{demand.status === 'pending' ? 'WAITING FOR ORDER' : demand.status === 'reserved' ? 'PROCESSING' : 'COMPLETED'}}</view>
        <view class="sb-title">{{demand.statusText}}</view>
        <view class="sb-sub">{{demand.id}} · {{demand.product}}</view>
      </view>
      <view class="sb-icon">
        <image class="icon-lg" src="{{demand.status === 'pending' ? icons.flag[1] : demand.status === 'reserved' ? icons.route[1] : icons.check[1]}}" mode="aspectFit"/>
      </view>
    </view>
  </view>

  <!-- 需求信息 -->
  <view class="card">
    <view class="card-head row between">
      <text class="title-md">需求信息</text>
      <view class="tag" wx:if="{{demand.urgent}}" style="color:#f87171;border-color:rgba(248,113,113,.45)">紧急</view>
    </view>
    <view class="info-grid">
      <view class="info-item">
        <text class="info-k">产品名称</text>
        <text class="info-v">{{demand.product}}</text>
      </view>
      <view class="info-item">
        <text class="info-k">类别</text>
        <text class="info-v">{{demand.category || '—'}}</text>
      </view>
      <view class="info-item">
        <text class="info-k">数量</text>
        <text class="info-v num">{{demand.qty}}{{demand.unit}}</text>
      </view>
      <view class="info-item">
        <text class="info-k">库位批次</text>
        <text class="info-v">{{demand.lot}}</text>
      </view>
      <view class="info-item">
        <text class="info-k">客户</text>
        <text class="info-v">{{demand.customer}}</text>
      </view>
      <view class="info-item">
        <text class="info-k">期望时段</text>
        <text class="info-v c-cyan">{{demand.window}}</text>
      </view>
      <view class="info-item" wx:if="{{demand.note}}">
        <text class="info-k">备注</text>
        <text class="info-v">{{demand.note}}</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="row between">
      <text class="text-dim text-xs">创建于 {{demand.createTime}}</text>
      <text class="text-dim text-xs">协同单号 {{demand.id}}</text>
    </view>
  </view>

  <!-- 关联预约 -->
  <view class="section-title" wx:if="{{reserve}}">关联提货预约</view>
  <view class="card clickable" wx:if="{{reserve}}" hover-class="role-card-hover" bindtap="goReserve">
    <view class="row between">
      <view class="row gap12">
        <view class="d-icon di-cyan"><image class="icon-sm" src="{{icons.truck[1]}}" mode="aspectFit"/></view>
        <view class="col">
          <text class="title-sm">预约单 {{reserve.id}}</text>
          <text class="text-dim text-xs mt16">{{reserve.plate}} · {{reserve.driver}}</text>
        </view>
      </view>
      <view class="tag c-cyan brd-cyan"><text class="dot" style="background:{{reserve.color}}"></text>{{reserve.statusText}}</view>
    </view>
    <view class="row between mt16">
      <text class="text-dim text-sm">月台：{{reserve.dock || '待分配'}}</text>
      <text class="text-dim text-sm">时段：{{reserve.eta || '待定'}}</text>
    </view>
  </view>

  <!-- 等待物流方承接 -->
  <view class="card plain ghost-wait" wx:if="{{demand.status === 'pending'}}">
    <view class="row gap12">
      <view class="pulse"><image class="icon" src="{{icons.truck[0]}}" mode="aspectFit"/></view>
      <view class="col grow">
        <text class="title-sm">等待物流方承接</text>
        <text class="text-dim text-xs mt16">需求单已进入协同池，物流方承接后将创建提货预约</text>
      </view>
    </view>
  </view>

  <!-- 撤回 -->
  <button wx:if="{{demand.status === 'pending'}}" class="btn danger block" hover-class="button-hover" bindtap="withdraw">撤回该需求单</button>
</view>
