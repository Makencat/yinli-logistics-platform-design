.home {
  background-image:
    radial-gradient(1100rpx 900rpx at 90% -10%, rgba(47, 107, 255, 0.14), transparent 60%),
    radial-gradient(900rpx 700rpx at -20% 30%, rgba(34, 211, 238, 0.07), transparent 60%);
}

/* ============ 顶部品牌区（去拥挤化：分区分层 + 留白节奏） ============ */
.masthead {
  border-radius: 34rpx;
  padding: 34rpx 32rpx 30rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(150deg, rgba(15, 26, 56, 0.95), rgba(8, 13, 26, 0.9));
  border: 1px solid rgba(77, 141, 255, 0.3);
  position: relative;
  overflow: hidden;
}
.mast-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.brand-chip { display: flex; align-items: center; gap: 20rpx; }
.brand-logo {
  width: 88rpx; height: 88rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #2f6bff, #22d3ee);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(47, 107, 255, 0.55), inset 0 1px 0 rgba(255,255,255,0.25);
}
.brand-name {
  font-family: 'Bahnschrift', 'Arial', sans-serif;
  font-size: 33rpx; font-weight: 800;
  letter-spacing: 6rpx;
  color: #eaf2ff;
}
.brand-sub { font-size: 23rpx; color: #a8bad6; margin-top: 6rpx; letter-spacing: 1rpx; }
.demo-chip {
  display: flex; align-items: center; gap: 10rpx;
  background: rgba(34, 211, 238, 0.12);
  border: 1px solid rgba(34, 211, 238, 0.4);
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #22d3ee;
  flex-shrink: 0;
}
.demo-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 6rpx rgba(52, 211, 153, 0.9);
  animation: pulse 1.4s infinite;
}
@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.35; }
  100% { opacity: 1; }
}

/* 标题区：与品牌区留出清晰间隔，独立成层 */
.hero-wrap {
  margin-top: 36rpx;
  padding-top: 30rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.14);
}
.hero-title {
  font-size: 42rpx; font-weight: 800;
  color: #eaf2ff;
  letter-spacing: 1rpx;
  line-height: 1.3;
}
.hero-sub { font-size: 24rpx; color: #a8bad6; margin-top: 14rpx; letter-spacing: 1rpx; }

.flow-strip {
  display: flex; align-items: center; flex-wrap: wrap;
  margin-top: 28rpx;
  row-gap: 14rpx;
}
.flow-item { display: flex; align-items: center; }
.flow-tag {
  font-size: 23rpx;
  color: #9fb6d8;
  background: rgba(77, 141, 255, 0.16);
  border: 1px solid rgba(77, 141, 255, 0.35);
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
}
.flow-link { color: #22d3ee; margin: 0 12rpx; font-size: 24rpx; }

.mast-stats {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 28rpx 8rpx 4rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}
.mast-stat { flex: 1; text-align: center; display: flex; flex-direction: column; gap: 8rpx; }
.stat-num { font-size: 42rpx; line-height: 1.1; }
.stat-k { font-size: 23rpx; letter-spacing: 1rpx; }
.mast-line {
  width: 1px; height: 46rpx;
  background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.16), transparent);
}

/* ============ 驾驶舱 / 消息中心 快捷入口（渐变 + 发光 + 专属图标底板） ============ */
.quick-row { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.quick-card {
  flex: 1;
  display: flex; align-items: center; gap: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(160deg, rgba(30, 44, 76, 0.9), rgba(16, 24, 44, 0.95));
  border: 1px solid rgba(133, 168, 226, 0.36);
  box-shadow: 0 4rpx 12rpx rgba(2, 6, 16, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.07);
  position: relative;
  overflow: visible;
}
.quick-card::before {
  content: '';
  position: absolute;
  top: 0; left: 24rpx; right: 24rpx;
  height: 1px;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.5), transparent);
  opacity: 0.6;
}
.quick-bar { flex: 1.3; }
.quick-emblem {
  width: 76rpx; height: 76rpx;
  border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.qe-blue {
  background: linear-gradient(145deg, rgba(47, 107, 255, 0.28), rgba(47, 107, 255, 0.1));
  border: 1px solid rgba(77, 141, 255, 0.55);
  box-shadow: 0 0 6rpx rgba(47, 107, 255, 0.4), inset 0 1px 0 rgba(255,255,255,0.2);
}
.qe-cyan {
  background: linear-gradient(145deg, rgba(34, 211, 238, 0.24), rgba(34, 211, 238, 0.08));
  border: 1px solid rgba(34, 211, 238, 0.55);
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.35), inset 0 1px 0 rgba(255,255,255,0.2);
}
/* v5: 图标改为 <view>+CSS 背景，见文件末尾 .ic 定义 */
.q-body { flex: 1; min-width: 0; gap: 4rpx; }
.q-title { font-size: 30rpx; font-weight: 700; color: #eaf2ff; letter-spacing: 1rpx; }
.q-sub { font-size: 23rpx; color: #9db1cd; letter-spacing: 0.5rpx; }
.q-go { font-size: 30rpx; flex-shrink: 0; }
.msg-badge {
  position: absolute; top: -12rpx; right: -8rpx;
  min-width: 36rpx; height: 36rpx; padding: 0 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f87171, #f59e0b);
  font-size: 23rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 6rpx rgba(248, 113, 113, 0.6);
}

/* ============ 区块标题 ============ */
.section-title {
  font-size: 29rpx; font-weight: 700;
  margin: 0 6rpx 10rpx;
  display: flex; align-items: center;
  letter-spacing: 1rpx;
}
.section-title::before {
  content: '';
  width: 8rpx; height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6bff, #22d3ee);
  margin-right: 14rpx;
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.5);
}

/* ============ 选择角色：四卡片（专属图标底板 + 质感层级 + 按压反馈） ============ */
.role-grid { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 8rpx; }
.role-card {
  display: flex; align-items: center; gap: 24rpx;
  border-radius: 28rpx;
  padding: 26rpx 24rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  border: 1px solid rgba(255, 255, 255, 0.09);
  box-shadow: 0 4rpx 12rpx rgba(2, 6, 16, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.06);
}
.mini-emblem {
  width: 88rpx; height: 88rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
}
.mini-icon { width: 50rpx; height: 50rpx; }
.glow-b {
  background: radial-gradient(circle at 30% 20%, rgba(47, 107, 255, 0.4), rgba(47, 107, 255, 0.1) 70%);
  border: 1px solid rgba(77, 141, 255, 0.6);
  box-shadow: 0 0 6rpx rgba(47, 107, 255, 0.4);
}
.glow-c {
  background: radial-gradient(circle at 30% 20%, rgba(34, 211, 238, 0.35), rgba(34, 211, 238, 0.08) 70%);
  border: 1px solid rgba(34, 211, 238, 0.6);
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.35);
}
.glow-p {
  background: radial-gradient(circle at 30% 20%, rgba(167, 139, 250, 0.35), rgba(167, 139, 250, 0.08) 70%);
  border: 1px solid rgba(167, 139, 250, 0.6);
  box-shadow: 0 0 6rpx rgba(167, 139, 250, 0.35);
}
.glow-g {
  background: radial-gradient(circle at 30% 20%, rgba(52, 211, 153, 0.35), rgba(52, 211, 153, 0.08) 70%);
  border: 1px solid rgba(52, 211, 153, 0.6);
  box-shadow: 0 0 6rpx rgba(52, 211, 153, 0.35);
}
.role-name { font-size: 29rpx; font-weight: 700; color: #eaf2ff; letter-spacing: 1rpx; }
.role-desc { font-size: 23rpx; color: #9db1cd; margin-top: 8rpx; letter-spacing: 0.5rpx; }
.go-arrow {
  font-size: 32rpx;
  width: 48rpx; height: 48rpx;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: rgba(34, 211, 238, 0.08);
  border: 1px solid rgba(34, 211, 238, 0.25);
}

/* ============ 协同链路 ============ */
.chain-card { padding: 16rpx 28rpx; }
.chain-row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
.chain-row:last-child { border-bottom: none; }
.chain-index {
  width: 54rpx; height: 54rpx; flex-shrink: 0;
  border-radius: 18rpx;
  background: linear-gradient(145deg, rgba(47, 107, 255, 0.2), rgba(34, 211, 238, 0.08));
  border: 1px solid rgba(77, 141, 255, 0.45);
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx;
  box-shadow: 0 0 6rpx rgba(47, 107, 255, 0.2);
}

/* ============ v5 图标：<view> + background-image 内联 url-encoded SVG ============ */
/* 语义：dock=品牌四宫格 / dashboard=驾驶舱仪表 / message=信封 / factory=厂房烟囱 / truck=货车 / warehouse=仓库 / box=立方体 */
/* 编码规范与 app.wxss 网格纹理一致：属性单引号、# 转 %23、url 双引号包裹 */
.ic {
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.ic-logo {
  width: 56rpx; height: 56rpx;
  background-image: url("data:image/png;base64,");
}
.ic-dashboard {
  width: 46rpx; height: 46rpx;
  background-image: url("data:image/png;base64,");
}
.ic-message {
  width: 46rpx; height: 46rpx;
  background-image: url("data:image/png;base64,");
}
.ic-factory {
  width: 50rpx; height: 50rpx;
  background-image: url("data:image/png;base64,");
}
.ic-truck {
  width: 50rpx; height: 50rpx;
  background-image: url("data:image/png;base64,");
}
.ic-warehouse {
  width: 50rpx; height: 50rpx;
  background-image: url("data:image/png;base64,");
}
.ic-box {
  width: 50rpx; height: 50rpx;
  background-image: url("data:image/png;base64,");
}
