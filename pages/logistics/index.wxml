<nav-bar title="物流运输 · 在途管控" show-back="{{true}}">
</nav-bar>

<view class="page">
  <view class="hero">
    <view class="grid-deco"></view>
    <view class="row between">
      <view class="col">
        <view class="hero-kicker">LOGISTICS · DISPATCH</view>
        <view class="hero-title">运力调度台</view>
        <view class="hero-sub">承接货源 · 提交预约 · 到厂签到</view>
      </view>
      <view class="hero-emblem lg-emblem" bindtap="goVehicles" hover-class="role-card-hover">
        <image class="icon-lg" src="{{icons.truck[1]}}" mode="aspectFit"/>
        <view class="lg-tip">车辆管理</view>
      </view>
    </view>
    <view class="row hero-stats">
      <view class="hero-stat" wx:for="{{head}}" wx:key="k">
        <view class="stat-num {{item.color}} num">{{item.v}}</view>
        <view class="stat-k text-sub">{{item.k}}</view>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="k"
      class="tab {{activeTab === item.k ? 'tab-on' : ''}}" hover-class="tap-hover"
      bindtap="onTapTab"
      data-k="{{item.k}}"
    >{{item.t}}<text wx:if="{{item.k === 'open' && openCount}}" class="tab-badge">{{openCount}}</text></view>
  </view>

  <view wx:if="{{shown.length === 0}}" class="empty">当前分类暂无运单</view>

  <!-- 可承接 card -->
  <block wx:for="{{shown}}" wx:key="id">
    <view
      class="card clickable"
      hover-class="role-card-hover"
      wx:if="{{activeTab === 'open'}}"
      bindtap="takeOrder"
      data-demand="{{item.demandId}}"
    >
      <view class="row between">
        <view class="row gap12 grow">
          <view class="d-icon di-warn"><image class="icon-sm" src="{{icons.flag[1]}}" mode="aspectFit"/></view>
          <view class="col grow">
            <view class="row gap12">
              <text class="title-sm">{{item.product}}</text>
              <view wx:if="{{item.urgent}}" class="tag c-red brd-red"><text>紧急</text></view>
            </view>
            <text class="text-dim text-xs mt16 ellip">{{item.category}} · 批次 {{item.lot}}</text>
          </view>
        </view>
        <view class="tag c-warn brd-warn"><text class="dot" style="background:#f59e0b"></text>待承接</view>
      </view>
      <view class="row gap24 mt16 d-meta">
        <text class="d-k">数量 <text class="d-v num">{{item.qtyText}}</text></text>
        <text class="d-k">客户 <text class="d-v">{{item.customer}}</text></text>
      </view>
      <view class="row between mt16">
        <text class="text-dim text-xs">需求 {{item.demandId}}</text>
        <view class="pill fill" style="background:linear-gradient(135deg,#2f6bff,#22d3ee)">
          立即承接 →
        </view>
      </view>
    </view>

    <!-- 在途/已完成 card -->
    <view
      class="card clickable"
      hover-class="role-card-hover"
      wx:else
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="row between">
        <view class="row gap12 grow">
          <view class="d-icon di-cyan"><image class="icon-sm" src="{{icons.truck[1]}}" mode="aspectFit"/></view>
          <view class="col grow">
            <text class="title-sm">{{item.id}}</text>
            <text class="text-dim text-xs mt16 ellip">{{item.plate}} · {{item.driver}}</text>
          </view>
        </view>
        <view class="tag {{item.status === 'done' ? 'c-green brd-green' : item.status === 'pending' ? 'c-warn brd-warn' : 'c-cyan brd-cyan'}}">
          <text class="dot" style="background:{{item.color}}"></text>{{item.statusText}}
        </view>
      </view>
      <view class="row gap24 mt16 d-meta">
        <text class="d-k">货物 <text class="d-v">{{item.product || '—'}}</text></text>
        <text class="d-k">数量 <text class="d-v num">{{item.qtyText || '—'}}</text></text>
      </view>
      <view class="row between mt16">
        <text class="text-dim text-xs" wx:if="{{item.dock}}">月台 {{item.dock}}</text>
        <text class="text-dim text-xs" wx:else>月台 待分配</text>
        <text class="c-cyan text-sm">预计 {{item.eta || '待定'}}</text>
      </view>
    </view>
  </block>
</view>
