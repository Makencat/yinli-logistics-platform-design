.margin-chip {
  width: 84rpx; height: 84rpx;
  border-radius: 24rpx;
  background: rgba(34, 211, 238, 0.14);
  border: 1px solid rgba(34, 211, 238, 0.4);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.form-card { padding: 30rpx; margin-top: 24rpx; }
.f-item { margin-bottom: 24rpx; }
.f-row { display: flex; gap: 20rpx; }
.f-label { font-size: 24rpx; color: #a8bad6; margin-bottom: 12rpx; }
.req { color: #f87171; }
.f-input {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 18rpx;
  padding: 0 24rpx;
  height: 84rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}
.ph { color: #7e91b4; }
.f-picker-v {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 18rpx;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between;
  font-size: 28rpx;
}
.f-picker-v image { transform: rotate(90deg); opacity: 0.6; }

.section-title {
  font-size: 30rpx; font-weight: 700;
  margin: 34rpx 6rpx 18rpx;
  display: flex; align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx; height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6bff, #22d3ee);
  margin-right: 14rpx;
}
.vehicle-row { display: flex; align-items: center; gap: 20rpx; }
.plate-chip {
  background: linear-gradient(90deg, #0b1226, #12203f);
  border: 1px solid rgba(34, 211, 238, 0.55);
  border-radius: 12rpx;
  padding: 14rpx 22rpx;
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.2);
  flex-shrink: 0;
}
.plate-text {
  font-family: 'Bahnschrift', 'Arial', sans-serif;
  font-weight: 700;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: #22d3ee;
}
