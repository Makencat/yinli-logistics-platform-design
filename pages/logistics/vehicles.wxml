<nav-bar title="车辆管理 · 运力池" show-back="{{true}}"></nav-bar>

<view class="page">
  <view class="card plain" style="display:flex;align-items:center;gap:16rpx">
    <view class="margin-chip">
      <image class="icon" src="{{icons.truck[1]}}" mode="aspectFit"/>
    </view>
    <view class="col grow">
      <text class="title-sm">在册运力 {{list.length}} 台</text>
      <text class="text-dim text-xs mt16">承接提货预约时自动带出车牌与司机信息</text>
    </view>
  </view>

  <button class="btn primary block mt16" hover-class="button-hover" bindtap="toggleForm">
    {{showForm ? '收起登记表单' : '+ 登记新车辆'}}
  </button>

  <view class="card plain form-card" wx:if="{{showForm}}">
    <view class="f-row">
      <view class="f-item grow">
        <view class="f-label">车牌号 <text class="req">*</text></view>
        <input class="f-input" placeholder="如 鲁A·12345" placeholder-class="ph" value="{{form.plate}}" maxlength="10" data-k="plate" bindinput="onInput"/>
      </view>
      <view class="f-item grow">
        <view class="f-label">司机 <text class="req">*</text></view>
        <input class="f-input" placeholder="司机姓名" placeholder-class="ph" value="{{form.driver}}" maxlength="10" data-k="driver" bindinput="onInput"/>
      </view>
    </view>
    <view class="f-item">
      <view class="f-label">联系电话</view>
      <input class="f-input" placeholder="手机号码" placeholder-class="ph" value="{{form.phone}}" maxlength="11" data-k="phone" bindinput="onInput"/>
    </view>
    <view class="f-item">
      <view class="f-label">车型</view>
      <picker range="{{types}}" bindchange="onType">
        <view class="f-picker-v">
          <text>{{form.type}}</text>
          <image class="icon-sm" src="{{icons.chevron_right[0]}}" mode="aspectFit"/>
        </view>
      </picker>
    </view>
    <button class="btn primary block" hover-class="button-hover" bindtap="addVehicle">确认登记</button>
  </view>

  <view class="section-title">在册车辆</view>
  <view wx:if="{{list.length === 0}}" class="empty">运力池为空，请先登记车辆</view>
  <view class="card clickable vehicle-row" wx:for="{{list}}" wx:key="plate" hover-class="role-card-hover">
    <view class="plate-chip">
      <text class="plate-text">{{item.plate}}</text>
    </view>
    <view class="col grow">
      <text class="title-sm">{{item.driver}}</text>
      <text class="text-dim text-xs mt16">{{item.type}} · {{item.phone}}</text>
    </view>
    <view class="icon-btn" hover-class="tap-hover" bindtap="removeVehicle" data-plate="{{item.plate}}">
      <image class="icon-sm" src="{{icons.trash[0]}}" mode="aspectFit"/>
    </view>
  </view>
</view>
