.d-icon {
  width: 68rpx; height: 68rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.di-warn { background: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.4); }
.d-meta { flex-wrap: wrap; }
.d-k { font-size: 24rpx; color: #93a7c4; }
.d-v { color: #dbe6f7; font-weight: 500; }

/* 表单 */
.form-card { padding: 34rpx 30rpx; }
.card-head { margin-bottom: 10rpx; }
.f-item { margin-bottom: 28rpx; }
.f-row { display: flex; gap: 24rpx; }
.f-label { font-size: 24rpx; color: #a8bad6; margin-bottom: 12rpx; }
.req { color: #f87171; }
.f-static {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 18rpx;
  height: 84rpx;
  padding: 0 24rpx;
  display: flex; align-items: center;
  font-size: 28rpx;
  color: #dbe6f7;
  box-sizing: border-box;
}
.f-picker-v {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 18rpx;
  height: 84rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between;
  font-size: 28rpx;
}
.f-picker-v image { transform: rotate(90deg); opacity: 0.6; }
.ph { color: #7e91b4; }

/* 状态横幅复用 */
.state-banner {
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  border: 1px solid;
}
.state-reserved {
  background: linear-gradient(135deg, rgba(47, 107, 255, 0.3), rgba(34, 211, 238, 0.18));
  border-color: rgba(77, 141, 255, 0.4);
}
.state-done {
  background: linear-gradient(135deg, rgba(52, 211, 153, 0.22), rgba(34, 211, 238, 0.14));
  border-color: rgba(52, 211, 153, 0.4);
}
.sb-kicker { font-size: 23rpx; letter-spacing: 4rpx; opacity: 0.555; }
.sb-title { font-size: 42rpx; font-weight: 800; margin: 8rpx 0 4rpx; }
.sb-sub { font-size: 24rpx; opacity: 0.85; }
.sb-icon {
  width: 110rpx; height: 110rpx;
  border-radius: 30rpx;
  background: rgba(10, 15, 30, 0.4);
  display: flex; align-items: center; justify-content: center;
}
.section-title {
  font-size: 30rpx; font-weight: 700;
  margin: 30rpx 6rpx 18rpx;
  display: flex; align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx; height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6bff, #22d3ee);
  margin-right: 14rpx;
}
.tl-line { display: block; }
