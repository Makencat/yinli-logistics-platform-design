<nav-bar title="协同驾驶舱 · 总览" show-back="{{true}}"></nav-bar>

<view class="page">
  <view class="hero dash-hero">
    <view class="grid-deco"></view>
    <view class="row between">
      <view class="col">
        <view class="hero-kicker">WAREHOUSE-DISTRIBUTION · {{dateText}}</view>
        <view class="hero-title">供应链协同总览</view>
        <view class="hero-sub">四角色提货预约 · 一张看板统揽全局</view>
      </view>
      <view class="radar-ring">
        <view class="radar-core"></view>
      </view>
    </view>
  </view>

  <!-- KPI -->
  <view class="kpi-grid">
    <view class="kpi-card" wx:for="{{kpi}}" wx:key="k">
      <view class="kpi-icon"><image class="icon-sm" src="{{item.icon}}" mode="aspectFit"/></view>
      <view class="num {{item.color}}" style="font-size:40rpx">{{item.v}}</view>
      <view class="text-dim text-xs mt8">{{item.k}}</view>
    </view>
  </view>

  <!-- 角色入口 -->
  <view class="section-title">角色中枢</view>
  <view class="role-grid">
    <view class="role-card" wx:for="{{roles}}" wx:key="n" data-url="{{item.url}}" bindtap="goRole" hover-class="role-card-hover">
      <view class="row gap12">
        <view class="mini-emblem {{item.glow}}"><image class="icon-sm" src="{{item.icon}}" mode="aspectFit"/></view>
        <view class="col">
          <text class="title-sm">{{item.n}}</text>
          <text class="text-dim text-xs mt8">{{item.d}}</text>
        </view>
      </view>
      <view class="row between mt16">
        <text class="c-cyan text-xs">进入工作台 →</text>
      </view>
    </view>
  </view>

  <!-- 需求状态分布 -->
  <view class="section-title">货源需求分布</view>
  <view class="card plain">
    <view class="bar-row" wx:for="{{demandStats}}" wx:key="k">
      <text class="bar-label">{{item.k}}</text>
      <view class="bar-track">
        <view class="bar-fill" style="width:{{item.v * 16}}%;background:linear-gradient(90deg,{{item.color}}bb,{{item.color}})"></view>
      </view>
      <text class="num c-cyan">{{item.v}}</text>
    </view>
  </view>

  <!-- 预约状态分布 -->
  <view class="section-title">提货预约状态</view>
  <view class="card plain">
    <view class="bar-row" wx:for="{{reserveStats}}" wx:key="k">
      <text class="bar-label">{{item.k}}</text>
      <view class="bar-track">
        <view class="bar-fill" style="width:{{item.pct}}%;background:linear-gradient(90deg,{{item.color}}bb,{{item.color}})"></view>
      </view>
      <text class="num c-cyan">{{item.v}}</text>
    </view>
  </view>

  <!-- 今日排程 -->
  <view class="section-title">今日到厂排程</view>
  <view class="card plain">
    <view wx:for="{{timeline}}" wx:key="id" class="tl-row">
      <view class="tl-time num c-cyan">{{item.eta.split('-')[0]}}</view>
      <view class="tl-body">
        <view class="row between">
          <text class="text-sm">{{item.product}} · {{item.qtyText}}</text>
          <text class="text-xs" style="color:{{item.color}}">{{item.statusText}}</text>
        </view>
        <text class="text-dim text-xs mt8">{{item.plate}} · {{item.id}}</text>
      </view>
    </view>
    <view wx:if="{{timeline.length === 0}}" class="empty">今日暂无在途车辆</view>
  </view>
</view>
