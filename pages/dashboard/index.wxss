.dash-hero { min-height: auto; }
.radar-ring {
  width: 128rpx; height: 128rpx;
  border-radius: 50%;
  border: 1px dashed rgba(34, 211, 238, 0.5);
  display: flex; align-items: center; justify-content: center;
  animation: spin 18s linear infinite;
  margin-right: 6rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.radar-core {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 211, 238, 0.9), rgba(47, 107, 255, 0.2));
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.6);
}

.kpi-grid {
  display: flex; flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.kpi-card {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  border-radius: 26rpx;
  padding: 26rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  border: 1px solid rgba(255, 255, 255, 0.15);
  position: relative;
  overflow: hidden;
}
.kpi-card::after {
  content: '';
  position: absolute; right: -30rpx; top: -30rpx;
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(47, 107, 255, 0.25), transparent 70%);
}
.kpi-icon {
  width: 54rpx; height: 54rpx;
  border-radius: 16rpx;
  background: rgba(47, 107, 255, 0.14);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 18rpx;
}

.role-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.role-card {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  border-radius: 26rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.15);
}
.mini-emblem {
  width: 64rpx; height: 64rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.glow-b { background: rgba(47, 107, 255, 0.16); border: 1px solid rgba(77, 141, 255, 0.5); }
.glow-c { background: rgba(34, 211, 238, 0.14); border: 1px solid rgba(34, 211, 238, 0.5); }
.glow-p { background: rgba(167, 139, 250, 0.14); border: 1px solid rgba(167, 139, 250, 0.5); }
.glow-g { background: rgba(52, 211, 153, 0.14); border: 1px solid rgba(52, 211, 153, 0.5); }

.section-title {
  font-size: 30rpx; font-weight: 700;
  margin: 30rpx 6rpx 18rpx;
  display: flex; align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx; height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6bff, #22d3ee);
  margin-right: 14rpx;
}

.bar-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.bar-label { width: 120rpx; font-size: 24rpx; color: #a8bad6; }
.bar-track {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  overflow: hidden;
  margin: 0 20rpx;
}
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.35);
  transition: width 0.6s;
}

.tl-row { display: flex; gap: 20rpx; margin-bottom: 22rpx; align-items: flex-start; }
.tl-row:last-child { margin-bottom: 0; }
.tl-time {
  font-size: 30rpx; font-weight: 800;
  width: 96rpx; flex-shrink: 0;
  padding-top: 2rpx;
}
.tl-body {
  flex: 1;
  border-left: 2px solid rgba(77, 141, 255, 0.3);
  padding-left: 20rpx;
}
