.hero-emblem {
  width: 128rpx; height: 128rpx;
  border-radius: 34rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 10rpx;
}
.cs-emblem {
  background: rgba(52, 211, 153, 0.14);
  border: 1px solid rgba(52, 211, 153, 0.4);
  box-shadow: 0 0 6rpx rgba(52, 211, 153, 0.22);
}
.section-title {
  font-size: 30rpx; font-weight: 700;
  margin: 30rpx 6rpx 18rpx;
  display: flex; align-items: center;
}
.section-title::before {
  content: '';
  width: 8rpx; height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #2f6bff, #22d3ee);
  margin-right: 14rpx;
}
.c-icon {
  width: 68rpx; height: 68rpx;
  border-radius: 20rpx;
  background: rgba(52, 211, 153, 0.12);
  border: 1px solid rgba(52, 211, 153, 0.3);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.progress-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2f6bff, #22d3ee);
  box-shadow: 0 0 6rpx rgba(34, 211, 238, 0.5);
  transition: width 0.5s;
}
