<nav-bar title="客户门户 · 进度跟踪" show-back="{{true}}"></nav-bar>

<view class="page">
  <view class="hero">
    <view class="grid-deco"></view>
    <view class="row between">
      <view class="col">
        <view class="hero-kicker">CUSTOMER · TRACE</view>
        <view class="hero-title">订单提货看板</view>
        <view class="hero-sub">批次下发 · 协同提货 · 全程可视</view>
      </view>
      <view class="hero-emblem cs-emblem">
        <image class="icon-lg" src="{{icons.dashboard[1]}}" mode="aspectFit"/>
      </view>
    </view>
    <view class="row hero-stats">
      <view class="hero-stat" wx:for="{{head}}" wx:key="k">
        <view class="stat-num {{item.color}} num">{{item.v}}</view>
        <view class="stat-k text-sub">{{item.k}}</view>
      </view>
    </view>
  </view>

  <view class="section-title">我的提货批次</view>
  <view wx:if="{{shown.length === 0}}" class="empty">暂无提货批次</view>
  <view
    wx:for="{{shown}}"
    wx:key="id"
    class="card clickable"
    hover-class="role-card-hover"
    bindtap="goDetail"
    data-id="{{item.id}}"
  >
    <view class="row between">
      <view class="row gap12 grow">
        <view class="c-icon"><image class="icon-sm" src="{{icons.box[1]}}" mode="aspectFit"/></view>
        <view class="col grow">
          <text class="title-sm">{{item.product}} · 批次{{item.lot}}</text>
          <text class="text-dim text-xs mt16">{{item.category}} · {{item.customer}}</text>
        </view>
      </view>
      <view class="col" style="align-items:flex-end">
        <view class="num c-cyan" style="font-size:34rpx;line-height:1">{{item.qtyText}}</view>
        <text wx:if="{{item.reserve}}" class="text-dim text-xs mt12" style="color:{{item.reserve.color}}">{{item.reserve.statusText}}</text>
        <text wx:else class="text-dim text-xs mt12">待承接</text>
      </view>
    </view>
    <view class="progress-track mt16" wx:if="{{item.reserve}}">
      <view class="progress-fill" style="width:{{item.progress}}%"></view>
    </view>
  </view>
</view>
