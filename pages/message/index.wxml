<nav-bar title="协同消息中心" show-back="{{true}}"></nav-bar>

<view class="page">
  <view class="row gap12" style="margin-bottom:20rpx">
    <button wx:if="{{role !== 'customer'}}" class="btn ghost" hover-class="button-hover" bindtap="resetData" style="flex:1">重置演示数据</button>
    <button class="btn primary" hover-class="button-hover" bindtap="readAll" style="flex:1">全部已读</button>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">暂无消息</view>
  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card clickable msg-row"
    hover-class="role-card-hover"
  >
    <view class="msg-dot" wx:if="{{!item.read}}"></view>
    <view class="col grow">
      <view class="row between">
        <text class="title-sm">{{typeText[item.type] || '协同'}}</text>
        <text class="text-dim text-xs">{{item.time}}</text>
      </view>
      <text class="title-xs mt8">{{item.title}}</text>
      <text class="text-dim text-xs mt8 clamp2">{{item.text}}</text>
    </view>
  </view>
</view>
