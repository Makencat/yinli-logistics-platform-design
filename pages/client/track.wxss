.ship-card { padding-bottom: 26rpx; }

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.kv-addr {
  font-size: 23rpx;
  color: #9db1cd;
  margin-top: 8rpx;
  line-height: 1.5;
}
.kv-sm { font-size: 23rpx; font-weight: 500; }

.axis-title {
  font-size: 24rpx;
  color: #8fb2ff;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.stage-axis { padding: 0 4rpx; }
.stage-node .st { width: 100%; }

.timeline { margin-top: 12rpx; }
.timeline .tl-item {
  position: relative;
  padding-left: 42rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}
.timeline .tl-item:last-child::before { display: none; }

.expand-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 23rpx;
  color: #8ea3c2;
  letter-spacing: 1rpx;
}

/* ===== v9 ===== */
.ship-card { transition: transform 130ms ease, border-color 160ms ease; }
.kv-addr { line-height: 1.6; }
.expand-hint::after {
  content: '';
  display: inline-block;
  width: 12rpx; height: 12rpx;
  margin-left: 12rpx;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: translateY(-3rpx) rotate(45deg);
  opacity: 0.8;
}
