<nav-bar title="{{meta.navTitle}}" show-back="{{true}}"></nav-bar>

<view class="page auth-page">
  <view class="hero auth-hero">
    <view class="grid-deco"></view>
    <view class="row between">
      <view class="col grow">
        <view class="hero-kicker">{{meta.en}}</view>
        <view class="hero-title">{{meta.title}}</view>
        <view class="hero-sub">{{meta.sub}}</view>
      </view>
      <view class="auth-emblem {{meta.glow}}">
        <image class="icon-lg" src="{{meta.icon}}" mode="aspectFit"/>
      </view>
    </view>
  </view>

  <view class="card auth-card">
    <view class="field">
      <text class="field-label">账号</text>
      <input
        class="field-input {{focusKey === 'account' ? 'focus' : ''}}"
        value="{{account}}"
        maxlength="20"
        data-k="account"
        bindinput="onAccount"
        bindfocus="onFocus"
        bindblur="onBlur"
        placeholder="{{meta.userPh}}"
        placeholder-class="ph"
        confirm-type="next"
        bindconfirm="focusPwd"
      />
    </view>

    <view class="field">
      <text class="field-label">密码</text>
      <view class="row gap12">
        <input
          class="field-input grow {{focusKey === 'password' ? 'focus' : ''}}"
          value="{{password}}"
          password="{{!showPwd}}"
          maxlength="20"
          data-k="password"
          bindinput="onPassword"
          bindfocus="onFocus"
          bindblur="onBlur"
          placeholder="{{meta.pwdPh}}"
          placeholder-class="ph"
          confirm-type="done"
          bindconfirm="submit"
        />
        <view class="eye-btn" hover-class="eye-btn-hover" bindtap="togglePwd">
          <image class="icon-sm" src="{{showPwd ? icons.eye_off[1] : icons.eye[1]}}" mode="aspectFit"/>
        </view>
      </view>
    </view>

    <view wx:if="{{error}}" class="err-line"><text class="err-dot"></text>{{error}}</view>

    <view class="btn primary block mt24 {{locked ? 'is-loading' : ''}}" hover-class="button-hover" bindtap="submit">{{locked ? '登录中…' : meta.btn}}</view>

    <view class="row between mt16">
      <text class="text-dim text-xs">{{meta.tip}}</text>
      <view class="quick-fill" hover-class="quick-fill-hover" bindtap="quickFill">一键填入</view>
    </view>
  </view>

  <view class="tip-box">
    <text wx:if="{{role === 'staff'}}">员工端具备更高权限：可查看全部客户账户、调整货物分配仓库地址、挑选并指派运输师傅，还支持一键向客户推送通知。</text>
    <text wx:else>客户端登录后进入客户工作台，可查看本人货物的仓库位置、装车与出发状态、承运车辆与司机信息，以及完整进度时间轴。</text>
  </view>
</view>
